# EXERCÍCIO 1 — Referências (seção 15)
# ======================================================================
def exercicio_1_referencias():
    """
    Demonstra que 'b = a' compartilha o MESMO objeto (mesmo id), e que
    'b = a.copy()' cria um objeto novo e independente.
    """
    a = [10, 20, 30]
    b = a  # b não é uma lista nova: aponta para o mesmo objeto que 'a'

    b.append(40)  # como é o mesmo objeto, a mudança aparece em 'a' também

    print("a:", a)
    print("b:", b)
    print("id(a):", id(a))
    print("id(b):", id(b))  # -> igual a id(a), prova que é o mesmo objeto

    print("\n--- Comparação: usando .copy() em vez de b = a ---")
    c = [10, 20, 30]
    d = c.copy()  # cria um NOVO objeto (cópia rasa), com id diferente
    d.append(40)

    print("c:", c)  # não muda, pois d é independente de c
    print("d:", d)
    print("id(c):", id(c))
    print("id(d):", id(d))  # -> diferente de id(c)


