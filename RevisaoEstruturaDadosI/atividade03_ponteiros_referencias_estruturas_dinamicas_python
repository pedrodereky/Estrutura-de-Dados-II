# EXERCÍCIO 2 — Construindo uma cadeia A -> B -> C (seção 16)
# ======================================================================
def exercicio_2_cadeia():
    """Cria três nós, conecta A->B->C->None e percorre a cadeia."""

    class Node:
        def __init__(self, valor):
            self.valor = valor
            self.proximo = None  # referência para o próximo nó (ou None)

    n1 = Node("A")
    n2 = Node("B")
    n3 = Node("C")

    n1.proximo = n2  # A aponta para B
    n2.proximo = n3  # B aponta para C
    # n3.proximo continua None -> fim da cadeia

    # Percorre a cadeia a partir do início, seguindo as referências
    atual = n1
    while atual is not None:
        print(atual.valor)
        atual = atual.proximo


